// OpenShield — Database Schema
// Stack: PostgreSQL 16 + Prisma 6
// Security: encrypted credentials, hash-chained audit log, RBAC
// Monitoring: SSH events + DB login events (no query tracking — lightweight)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         UserRole  @default(OWNER)
  mfaSecret    String?   @map("mfa_secret") // TOTP, encrypted at rest
  mfaEnabled   Boolean   @default(false) @map("mfa_enabled")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  lastLoginIp  String?   @map("last_login_ip")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  assets        Asset[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([email])
  @@map("users")
}

enum UserRole {
  OWNER // Full access, including user management
  ADMIN // Manage assets, alerts; view audit
  VIEWER // Read-only
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") // SHA-256 of raw token
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  usedAt    DateTime? @map("used_at") // For rotation: set when token is exchanged for a new one
  createdAt DateTime  @default(now()) @map("created_at")
  ip        String?
  userAgent String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ============================================================
// ASSETS (servers being monitored)
// ============================================================

model Asset {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  // Top-level category: SSH | DATABASE | APP (apps = upcoming)
  category    AssetCategory @default(SSH) @map("category")
  // Deployment environment (PROD/STAGING/UAT/DEV/DR)
  environment Environment   @default(PROD) @map("environment")

  // ===== IDENTITAS SERVER (biar gampang manage banyak server) =====
  // displayName: alias manusiawi, mis. "prod-web-jkt-01"
  //   - Ditampilkan prominent di UI (lebih penting dari hostname/IP)
  //   - Kalau kosong, fallback ke hostname saat read
  //   - Format rekomendasi: <env>-<role>-<location>-<num>
  //     contoh: prod-web-jkt-01, staging-db-sg-02, dr-bastion-jkt-01
  displayName String? @map("display_name")
  // role: fungsi server (web/db/app/cache/lb/bastion/monitoring/logging/etc)
  role        String?
  // location: datacenter / cloud region (jkt/sg/aws-ap-southeast/gcp-asia/etc)
  location    String?
  // tags: JSON array of labels, mis. ["nginx","payment","tier-1","critical"]
  tags        Json?   @map("tags")
  // description: notes bebas (purpose, owner, runbook link, dll)
  description String? @db.Text

  hostname  String
  publicIp  String? @map("public_ip")
  privateIp String? @map("private_ip")
  os        String? // e.g. "Ubuntu 24.04", "Debian 12"
  kernel    String? // e.g. "6.8.0-124-generic"
  sshPort   Int     @default(22) @map("ssh_port")
  sshUser   String? @map("ssh_user")

  // Database sub-type (only filled when category = DATABASE)
  dbType DbType  @default(NONE) @map("db_type")
  dbHost String? @map("db_host")
  dbPort Int?    @map("db_port")
  dbName String? @map("db_name")
  dbUser String? @map("db_user")

  // ===== MULTI-DATABASE SCAN MODE =====
  // Opsi B: instead of monitoring 1 DB, scan ALL user databases on this server
  //   - When TRUE: dbName acts as a "bootstrap" DB for the discovery query
  //     (postgres for PG, mysql for MySQL, master for MSSQL)
  //   - Poller will: list databases → iterate per-DB → collect all events
  //   - discoveredDatabases: cached list of DBs (refreshed each poll cycle)
  //   - lastDiscoveryAt: when the list was last refreshed
  // When FALSE: monitor only the single dbName (legacy behavior)
  monitorAllDatabases Boolean   @default(false) @map("monitor_all_databases")
  discoveredDatabases Json?     @map("discovered_databases")
  lastDiscoveryAt     DateTime? @map("last_discovery_at")

  // ===== MYSQL CONNECTION AUDIT (general_log) =====
  // When TRUE: poller reads mysql.general_log TABLE for Connect/Quit events.
  // Requires manual SQL on target MySQL:
  //   SET GLOBAL log_output='TABLE';
  //   SET GLOBAL general_log='ON';
  // Privacy: only Connect/Quit + Access-denied rows are parsed; query bodies
  // are NEVER persisted to OpenShield.
  // MySQL only — PG/MSSQL ignore this flag.
  auditConnectionLog Boolean @default(false) @map("audit_connection_log")
  lastAuditEventId   BigInt? @map("last_audit_event_id") // mysql.general_log.event_time microsecond cursor

  status     AssetStatus @default(PENDING)
  lastSeenAt DateTime?   @map("last_seen_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  // Poller state — tracks incremental auth.log position + last run status
  // pollerCursor: byte offset in /var/log/auth.log (or log-specific cursor)
  pollerCursor String?      @map("poller_cursor")
  pollerStatus PollerStatus @default(IDLE) @map("poller_status")
  pollerError  String?      @map("poller_error")
  lastPolledAt DateTime?    @map("last_polled_at")
  pollCount    Int          @default(0) @map("poll_count")

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sshCredentials   AssetCredential?      @relation("SshCred")
  dbCredentials    AssetCredential?      @relation("DbCred")
  // 6 per-type event log relations (replaces serverEvents + dbEvents).
  // Note: t_event_log_database is the only one tied to Asset (poller-side).
  // t_event_log_server_auth can be tied to Asset (poller-side auth.log) or
  // Agent (agent-side sshd) — both nullable.
  serverAuthEvents TEventLogServerAuth[]
  databaseEvents   TEventLogDatabase[]
  alerts           Alert[]

  @@unique([userId, hostname])
  @@unique([userId, displayName])
  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([dbType])
  @@index([environment])
  @@index([role])
  @@index([displayName])
  @@map("assets")
}

enum AssetCategory {
  SSH // SSH login monitoring
  DATABASE // Database login monitoring (Postgres/MySQL/SQLServer)
  APP // Application access monitoring (upcoming)
}

enum Environment {
  PROD // Production (live customer-facing)
  STAGING // Pre-production mirror
  UAT // User Acceptance Testing
}

enum AssetStatus {
  PENDING // Just added, not yet polled
  ONLINE // Last poll < 2 min ago
  OFFLINE // Last poll > 5 min ago
  ERROR // Last poll failed
}

enum PollerStatus {
  IDLE // Not currently polling
  POLLING // Poll in progress
  OK // Last poll succeeded
  ERROR // Last poll failed (see pollerError)
}

enum DbType {
  NONE
  POSTGRES
  MYSQL
  SQLSERVER
}

// Encrypted credentials per asset
// One AssetCredential row per asset, with separate SSH and DB FK slots.
//   - SSH asset → sshAssetId set, sshEncData holds encrypted key/password
//   - DB asset  → dbAssetId set,  dbEncData holds encrypted password
// Splitting FK fields (instead of one assetId with dual @relation) avoids
// the Prisma 6 + Postgres constraint-rename bug that previously forced a
// destructive --force-reset during schema pushes.
model AssetCredential {
  id         String   @id @default(cuid())
  // Two nullable FK slots, each UNIQUE so at most one AssetCredential
  // can be attached to a given Asset on each side.
  sshAssetId String?  @unique @map("ssh_asset_id")
  dbAssetId  String?  @unique @map("db_asset_id")
  // Encrypted blob: iv (12B) + ciphertext + authTag (16B), base64 encoded
  sshEncData String?  @map("ssh_enc_data")
  dbEncData  String?  @map("db_enc_data")
  // Key version for rotation support
  keyVersion Int      @default(1) @map("key_version")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  sshAsset Asset? @relation("SshCred", fields: [sshAssetId], references: [id], onDelete: Cascade)
  dbAsset  Asset? @relation("DbCred", fields: [dbAssetId], references: [id], onDelete: Cascade)

  @@map("asset_credentials")
}

// ============================================================
// SSH EVENTS (login success/failed)
// ============================================================

// ============================================================
// EVENT LOG TABLES (per-type)
// ============================================================
// Architecture note (2026-06-21): we split the original `agent_events`,
// `server_events`, and `db_events` tables into 6 specialized tables for:
//   1. Cleaner separation per log source
//   2. Per-table retention / backup / archive policies
//   3. Tighter indexes (no JSONB scan, per-type columns)
//   4. Easier to extend (e.g. add fields specific to one log type)
//
// Tables:
//   t_event_log_syslog         — OS / daemon log (syslog, journal)
//   t_event_log_server_auth    — SSH/auth log (sshd from agent + auth.log poller)
//   t_event_log_fim            — File Integrity Monitoring (agent-side)
//   t_event_log_auditd         — Linux auditd (future, no events yet)
//   t_event_log_apps           — App-level audit (MySQL/PG/Redis/Nginx, etc.)
//   t_event_log_database       — DB login events (poller-side, login only)
//
// Each event type has its own severity enum where appropriate.
// All share `count` (dedup-aggregation) and `createdAt` for queries.

// ----- SYSLOG ----- //
// Generic system logs from /var/log/syslog, journal, etc.
// Agent-side only. No user/IP (those are extracted to server_auth when present).
model TEventLogSyslog {
  id        String   @id @default(cuid())
  agentId   String   @map("agent_id")
  // Severity level: INFO | WARN | ERROR | CRITICAL
  severity  String   @default("INFO")
  // Log source — file path or process name (e.g. "/var/log/syslog", "dockerd")
  source    String
  // Process name extracted from the log line (e.g. "python3", "systemd", "dockerd")
  // NULL if not parseable. Used for grouping in dashboard.
  process   String?
  // PID if extracted
  pid       Int?
  // Hostname where the log originated
  hostname  String?
  // Truncated message (240 chars) for dashboard. Full message in rawData->full_message.
  message   String
  // Structured details: full_message, _dedupSig, parser, eventTime, etc.
  rawData   Json?    @map("raw_data")
  eventTime DateTime @map("event_time")
  count     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, eventTime(sort: Desc)])
  @@index([severity, eventTime(sort: Desc)])
  @@index([process, eventTime(sort: Desc)])
  @@index([source, eventTime(sort: Desc)])
  @@map("t_event_log_syslog")
}

// ----- SERVER AUTH ----- //
// SSH/auth events: agent-side sshd parser + server-side auth.log poller.
// Unified: agentId OR assetId (one of them must be set).
model TEventLogServerAuth {
  id        String       @id @default(cuid())
  // agentId for agent-side sshd, NULL for poller-side
  agentId   String?      @map("agent_id")
  // assetId for poller-side, NULL for agent-side
  assetId   String?      @map("asset_id")
  // User trying to authenticate
  username  String
  sourceIp  String       @map("source_ip")
  // SUCCESS | FAILED | INVALID (invalid user)
  status    ServerStatus
  // Auth method: "publickey", "password", "keyboard-interactive", etc.
  method    String?
  // GeoIP country (NULL until GeoIP feature ships)
  country   String?
  // Event time
  eventTime DateTime     @map("event_time")
  // Raw log line (for audit/debug)
  raw       String?
  // Dedup aggregation: identical events within window are merged with count++.
  count     Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at")

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, eventTime(sort: Desc)])
  @@index([agentId, eventTime(sort: Desc)])
  @@index([sourceIp, eventTime(sort: Desc)])
  @@index([status, eventTime(sort: Desc)])
  @@index([username, eventTime(sort: Desc)])
  @@map("t_event_log_server_auth")
}

// ----- FIM (File Integrity Monitoring) ----- //
// Tracks file changes detected by the agent.
// Action: ADDED (new file in baseline) | MODIFIED (hash changed) | REMOVED (file gone)
model TEventLogFim {
  id        String    @id @default(cuid())
  agentId   String    @map("agent_id")
  // Severity: WARN (default) | CRITICAL (e.g. /etc/passwd modified)
  severity  String    @default("WARN")
  // ADDED | MODIFIED | REMOVED
  action    String
  // File path that changed
  path      String
  // SHA-256 hash BEFORE the change (NULL for ADDED)
  oldHash   String?   @map("old_hash")
  // SHA-256 hash AFTER the change (NULL for REMOVED)
  newHash   String?   @map("new_hash")
  // File size in bytes (NULL if file removed)
  size      BigInt?
  // File mode (e.g. "0644", "0600")
  mode      String?
  // File owner (e.g. "root:root")
  owner     String?
  // File mtime when change was detected
  fileTime  DateTime? @map("file_time")
  // Human-readable message
  message   String
  rawData   Json?     @map("raw_data")
  eventTime DateTime  @map("event_time")
  count     Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, eventTime(sort: Desc)])
  @@index([path, eventTime(sort: Desc)])
  @@index([action, eventTime(sort: Desc)])
  @@index([severity, eventTime(sort: Desc)])
  @@map("t_event_log_fim")
}

// ----- AUDITD ----- //
// Linux auditd events. No events yet (agent doesn't ship auditd parser).
// Schema is a forward-compat placeholder; fields can be tightened once
// we have real data.
model TEventLogAuditd {
  id        String   @id @default(cuid())
  agentId   String   @map("agent_id")
  severity  String   @default("INFO")
  // auditd type, e.g. "USER_LOGIN", "SYSCALL", "USER_CMD"
  eventType String   @map("event_type")
  // Auditd message type code, e.g. 1112 (user login)
  typeCode  Int?     @map("type_code")
  // Process that triggered the audit event
  process   String?
  pid       Int?
  // User (uid) and effective user (euid)
  uid       String?
  euid      String?
  // Audit summary string (e.g. "uid=0 exe=... terminal=pts/0 success=0")
  message   String
  rawData   Json?    @map("raw_data")
  eventTime DateTime @map("event_time")
  count     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, eventTime(sort: Desc)])
  @@index([eventType, eventTime(sort: Desc)])
  @@index([severity, eventTime(sort: Desc)])
  @@map("t_event_log_auditd")
}

// ----- APPS ----- //
// Application-level audit logs: MySQL audit, PG audit, Redis, Nginx, Apache, etc.
// Generic enough to host multiple app types via `appName` field.
model TEventLogApps {
  id        String   @id @default(cuid())
  agentId   String   @map("agent_id")
  // App name, e.g. "mysql", "postgresql", "redis", "nginx"
  appName   String   @map("app_name")
  // Sub-event within app, e.g. "mysql.connect.success", "mysql.disconnect",
  // "pg.connect.failed". Free-form string for flexibility.
  event     String
  // Severity: INFO | WARN | ERROR | CRITICAL
  severity  String   @default("INFO")
  // Optional user (e.g. db user from connect log)
  username  String?
  // Optional source IP
  sourceIp  String?  @map("source_ip")
  // Optional database name (for DB audit)
  database  String?
  // Human-readable message
  message   String
  rawData   Json?    @map("raw_data")
  eventTime DateTime @map("event_time")
  count     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, eventTime(sort: Desc)])
  @@index([appName, eventTime(sort: Desc)])
  @@index([event, eventTime(sort: Desc)])
  @@index([severity, eventTime(sort: Desc)])
  @@index([username, eventTime(sort: Desc)])
  @@index([sourceIp, eventTime(sort: Desc)])
  @@map("t_event_log_apps")
}

// ----- DATABASE ----- //
// DB login events from the server-side poller (auth_log/audit_log).
// Privacy: only login success/fail/denied — never query bodies.
model TEventLogDatabase {
  id        String        @id @default(cuid())
  assetId   String        @map("asset_id")
  // POSTGRES | MYSQL | SQLSERVER
  dbType    DbType        @map("db_type")
  // DB user
  username  String
  sourceIp  String?       @map("source_ip")
  // DB name
  database  String?
  // SUCCESS | FAILED | DENIED
  status    DbEventStatus
  eventTime DateTime      @map("event_time")
  // Raw log line (for audit/debug)
  raw       String?
  count     Int           @default(1)
  createdAt DateTime      @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, eventTime(sort: Desc)])
  @@index([username, eventTime(sort: Desc)])
  @@index([sourceIp, eventTime(sort: Desc)])
  @@index([status, eventTime(sort: Desc)])
  @@index([dbType, eventTime(sort: Desc)])
  @@map("t_event_log_database")
}

enum ServerStatus {
  SUCCESS
  FAILED
  INVALID // invalid user
}

enum DbEventStatus {
  SUCCESS // login OK
  FAILED // auth failed
  DENIED // access denied (e.g. pg_hba.conf reject)
}

// ============================================================
// ALERTS
// ============================================================

model Alert {
  id          String        @id @default(cuid())
  assetId     String?       @map("asset_id")
  severity    AlertSeverity
  title       String
  description String        @db.Text
  metadata    Json? // { sourceIp, eventCount, window, etc. }
  status      AlertStatus   @default(OPEN)
  resolvedAt  DateTime?     @map("resolved_at")
  resolvedBy  String?       @map("resolved_by")
  createdAt   DateTime      @default(now()) @map("created_at")

  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([severity, createdAt])
  @@map("alerts")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// ============================================================
// AUDIT LOG (append-only, hash-chained for tamper detection)
// ============================================================

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  action       String // e.g. "auth.login.success", "asset.create", "credential.view"
  resourceType String?  @map("resource_type") // e.g. "asset", "user"
  resourceId   String?  @map("resource_id")
  ip           String?
  userAgent    String?  @map("user_agent")
  metadata     Json?
  // Hash chain
  prevHash     String?  @map("prev_hash") // hex SHA-256 of previous row
  hash         String // hex SHA-256 of (prevHash + row content)
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================================
// SYSTEM SETTINGS (singleton, key-value)
// ============================================================

model SystemSetting {
  key       String   @id
  value     String // JSON-encoded value
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_settings")
}

// ============================================================
// AGENTS (Bash/Python agents running on monitored hosts)
// Optional, complements the centralized poller for hosts where
// SSH/DB access isn't available or deeper coverage is required.
// ============================================================

model Agent {
  id            String      @id @default(cuid())
  // Human-readable alias, e.g. "prod-web-jkt-01-agent"
  name          String
  // Short display ID, e.g. "OP-01", "OP-02" — sequential, easy to reference.
  // NULL-able so existing agents can coexist; assigned by server via
  // scripts/migrate-agent-display-id.ts and src/lib/agent-display-id.ts.
  // Cuid (id) remains the canonical auth identity.
  displayId     String?     @unique @map("display_id")
  // hostname + ip are reported by the agent on first heartbeat.
  // For admin-initiated flow (POST /api/agents) they're null until
  // the agent comes online and reports its identity.
  hostname      String?
  ip            String?
  // Agent implementation
  type          AgentType
  // Self-reported agent version (from agent.py VERSION constant).
  // Compared against AGENT_COMPAT_MIN (src/lib/agent-versions.ts)
  // on every heartbeat to detect outdated agents.
  version       String      @default("1.0.0") // agent-reported version
  os            String? // e.g. "Ubuntu 24.04"
  kernel        String? // e.g. "6.8.0-124-generic"
  // Deployment environment — helps group/filter agents in UI
  // (e.g. list all prod agents, alert on staging breach, etc.)
  environment   Environment @default(PROD) @map("environment")
  // Lifecycle
  status        AgentStatus @default(REGISTERED)
  lastHeartbeat DateTime?   @map("last_heartbeat")
  lastError     String?     @map("last_error")
  registeredAt  DateTime    @default(now()) @map("registered_at")
  revokedAt     DateTime?   @map("revoked_at")
  // HMAC secret for authenticating agent-originated requests.
  // Stored as SHA-256 hash (server never sees the plaintext again once
  // returned to the agent on registration). Actual HMAC key is shown
  // ONCE during registration and must be persisted by the agent.
  // We keep the plaintext secret encrypted at rest using the same
  // key as AssetCredential (so admins can rotate agent secrets
  // from the UI without losing the agent's identity).
  secretEnc     String?     @map("secret_enc")
  // Config the agent pulls on each heartbeat (logs to watch, etc.)
  config        Json?
  // Stats
  eventsSent    Int         @default(0) @map("events_sent")

  // 6 per-type event log relations (replaces single AgentEvent[]).
  // Each event type has its own table for cleaner separation, per-type
  // retention/backup, and tighter indexes. See EVENT LOG TABLES section.
  syslogEvents     TEventLogSyslog[]
  serverAuthEvents TEventLogServerAuth[]
  fimEvents        TEventLogFim[]
  auditdEvents     TEventLogAuditd[]
  appEvents        TEventLogApps[]

  // Removed: @@unique([hostname, type]) — incompatible with admin-initiated
  // flow where multiple agents can run on the same host (each with own agentId).
  // The agentId (cuid) is the unique identity for auth.
  @@index([status])
  @@index([type])
  @@index([hostname])
  @@map("agents")
}

enum AgentType {
  BASH // agent.sh — zero deps, log file watching
  PYTHON // agent.py — full features, FIM, process monitor
}

enum AgentStatus {
  REGISTERED // created but no heartbeat yet
  ONLINE // last heartbeat < 2 min ago
  STALE // last heartbeat 2-10 min ago
  OFFLINE // last heartbeat > 10 min ago
  ERROR // last heartbeat returned error
  REVOKED // admin disabled this agent
}

// Events sent by agents. Different shape than ServerEvent/DbEvent
// (which are server-side captured). AgentEvent covers:
//   - log.line    : parsed line from a watched log file
//   - file.change : file integrity hash mismatch
//   - process.new : new suspicious process started
//   - metric.system : CPU/RAM/disk/network sample
//   - custom      : user-defined plugin output
// NOTE: AgentEvent model removed 2026-06-21. Use 6 specialized tables:
//   TEventLogSyslog, TEventLogServerAuth, TEventLogFim,
//   TEventLogAuditd, TEventLogApps, TEventLogDatabase.
// See the "EVENT LOG TABLES" section above for the new schema.
