# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenShield custom
/next
/openshield@0.1.0
/agents/python/__pycache__/
/agents/python/*.py3
*.bak-*
/scripts/cleanup-test-assets.ts
/scripts/list-users.ts
/scripts/test-env-log.ts
